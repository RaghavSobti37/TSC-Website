      "source": "/assets/mirror/siteassets.parastorage.com/pages/pages/thunderbolt",
      "has": [
        {
          "type": "query",
          "key": "module",
          "value": "(?<module>[^&]+)"
        },
        {
          "type": "query",
          "key": "pageId",
          "value": "(?<pageId>[^&]+)"
        },
        {
          "type": "query",
          "key": "formFactor",
          "value": "(?<formFactor>[^&]+)"
        },
        {
          "type": "query",
          "key": "fileId",
          "value": "(?<fileId>[^&]+)"
        }
      ],
      "destination": "/assets/mirror/siteassets.parastorage.com/pages/pages/thunderbolt/:module--:pageId--:formFactor--:fileId.json"
    },
    {
      "source": "/assets/mirror/static.wixstatic.com/media/:asset/v1/:transform*",
      "destination": "https://static.wixstatic.com/media/:asset/v1/:transform*"
    }
  ],
  "headers": [
    {
      "source": "/css/mobile/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/tsc-wix-motion.js",
